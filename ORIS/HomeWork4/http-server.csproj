<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>http_server</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <None Update="server.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="static\index.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="static\404.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="static\errorPages\500.html">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="static\errorPages\404.html">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="static\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Content Include="static\koleso.ru\.idea\.gitignore" />
      <Content Include="static\koleso.ru\.idea\koleso.ru.iml" />
      <Content Include="static\koleso.ru\.idea\modules.xml" />
      <Content Include="static\koleso.ru\.idea\vcs.xml" />
      <Content Include="static\koleso.ru\.idea\workspace.xml" />
      <Content Include="static\rockstargames\.idea\.gitignore" />
      <Content Include="static\rockstargames\.idea\modules.xml" />
      <Content Include="static\rockstargames\.idea\rockstargames.iml" />
      <Content Include="static\rockstargames\.idea\workspace.xml" />
    </ItemGroup>

</Project>
